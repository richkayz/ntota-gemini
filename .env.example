# Nyota One Complete Business Platform Environment Variables
# Copy to .env for local configuration

# Port configuration
PORT=3000
NODE_ENV=development

# Base URL for callbacks and public assets
APP_BASE_URL=https://nyotaone.com

# Gemini API Key (required for Amara Business Advisor)
# On Google AI Studio, GEMINI_API_KEY is automatically injected
GEMINI_API_KEY=

# PesaPal API 3.0 Credentials
# Sandbox endpoint: https://cybqa.pesapal.com/pesapalv3
# Live endpoint: https://pay.pesapal.com/v3
PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=your_pesapal_consumer_key
PESAPAL_CONSUMER_SECRET=your_pesapal_consumer_secret
PESAPAL_IPN_ID=your_registered_ipn_notification_id

# Supabase / PostgreSQL Credentials (Optional for remote connection, defaults to integrated robust store)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Business Communication
SUPPORT_EMAIL=support@nyotaone.com
WHATSAPP_NUMBER=+256702086774
UG_PHONE=+256772023461
UK_PHONE=+447472105295
